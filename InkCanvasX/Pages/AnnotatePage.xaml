<UserControl x:Class="SkiaAnnotate.Pages.AnnotatePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#F3F5F8">
        <Border Width="760"
                Padding="24"
                CornerRadius="10"
                Background="White"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel>
                <TextBlock FontSize="24"
                           FontWeight="SemiBold"
                           Text="PPT 联动批注模式" />
                <TextBlock Margin="0,8,0,20"
                           Foreground="#666"
                           Text="先在 PowerPoint 中打开PPT，再点击“连接 PowerPoint”；放映开始后会自动出现浮动批注画布。" />

                <WrapPanel>
                    <Button Margin="0,0,12,0"
                            Padding="16,8"
                            Content="连接 PowerPoint"
                            Command="{Binding ConnectPowerPointCommand}" />
                    <Button Padding="16,8"
                            Content="{Binding LinkButtonText}"
                            Command="{Binding TogglePresentationModeCommand}"
                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" />
                </WrapPanel>

                <TextBlock Margin="0,18,0,0"
                           Text="{Binding SlideDisplayText, StringFormat=已加载页数：{0}}" />
                <TextBlock Margin="0,6,0,0"
                           Foreground="#666"
                           Text="{Binding StatusMessage}" />
                <TextBlock Margin="0,20,0,0"
                           Foreground="#666"
                           Text="提示：联动中可用浮动栏翻页、画笔/橡皮、清屏，停止放映后画布会自动隐藏。" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
