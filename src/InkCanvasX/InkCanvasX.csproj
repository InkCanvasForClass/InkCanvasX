<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <JaliumSourceRoot Condition="'$(JaliumSourceRoot)' == ''">$(MSBuildProjectDirectory)\..\..\..\Jalium.UI\</JaliumSourceRoot>
  </PropertyGroup>

  <Import Project="$(JaliumSourceRoot)src\managed\Jalium.UI.Build\build\Jalium.UI.Build.props"
          Condition="Exists('$(JaliumSourceRoot)src\managed\Jalium.UI.Build\build\Jalium.UI.Build.props')" />

  <PropertyGroup>
    <!-- 机器上若设置了环境变量 Version（如 Ice/构建链的 V7.xx），会污染 NuGet 还原；此处显式锁定合法 SemVer。 -->
    <Version>1.0.0</Version>
    <AssemblyName>InkCanvasX</AssemblyName>
    <RootNamespace>InkCanvasX</RootNamespace>
    <Product>Inkcanvas X</Product>
    <Nullable>enable</Nullable>
    <OutputType>WinExe</OutputType>
    <LangVersion>preview</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <TargetFramework>net10.0-windows</TargetFramework>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RestoreEnablePackagePruning>false</RestoreEnablePackagePruning>
    <UseJaliumSourceReferences>true</UseJaliumSourceReferences>
    <JaliumPackageVersion>26.10.5</JaliumPackageVersion>
    <_JalxamlTasksPath>$(JaliumSourceRoot)src\managed\Jalium.UI.Build\bin\$(Configuration)\net10.0\Jalium.UI.Build.dll</_JalxamlTasksPath>
    <JalxamlCompilerPath>$(JaliumSourceRoot)src\managed\Jalium.UI.Build\tools\jalxamlc.exe</JalxamlCompilerPath>

    <DebugType Condition="'$(Configuration)' == 'Debug'">portable</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Debug'">true</DebugSymbols>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(JaliumSourceRoot)src\managed\Jalium.UI.Core\Jalium.UI.Core.csproj" />
    <ProjectReference Include="$(JaliumSourceRoot)src\managed\Jalium.UI.Media\Jalium.UI.Media.csproj" />
    <ProjectReference Include="$(JaliumSourceRoot)src\managed\Jalium.UI.Input\Jalium.UI.Input.csproj" />
    <ProjectReference Include="$(JaliumSourceRoot)src\managed\Jalium.UI.Interop\Jalium.UI.Interop.csproj" />
    <ProjectReference Include="$(JaliumSourceRoot)src\managed\Jalium.UI.Controls\Jalium.UI.Controls.csproj" />
    <ProjectReference Include="$(JaliumSourceRoot)src\managed\Jalium.UI.Xaml\Jalium.UI.Xaml.csproj" />
    <ProjectReference Include="$(JaliumSourceRoot)src\managed\Jalium.UI.Gpu\Jalium.UI.Gpu.csproj" />
    <ProjectReference Include="$(JaliumSourceRoot)src\managed\Jalium.UI.Xaml.SourceGenerator\Jalium.UI.Xaml.SourceGenerator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      UndefineProperties="PublishAot;PublishTrimmed;PublishSingleFile;PublishReadyToRun;SelfContained;RuntimeIdentifier;RuntimeIdentifiers" />
    <ProjectReference Include="$(JaliumSourceRoot)src\managed\Jalium.UI.Build\Jalium.UI.Build.csproj"
                      ReferenceOutputAssembly="false"
                      BuildReference="false" />
    <ProjectReference Include="..\..\..\FluentJalium\src\FluentJalium\FluentJalium.csproj" />
  </ItemGroup>

  <!-- 不嵌入 .uic：避免 LoadFromCompiledResource 路线丢失 x:Name。强制走 XamlReader + 嵌入的 .jalxaml。 -->
  <Target Name="InkCanvasXSkipUicEmbed" AfterTargets="EmbedCompiledJalxaml">
    <ItemGroup>
      <EmbeddedResource Remove="@(EmbeddedResource)"
                        Condition="$([System.String]::Copy('%(LogicalName)').EndsWith('AnnotationToolbarWindow.uic'))" />
      <EmbeddedResource Remove="@(EmbeddedResource)"
                        Condition="$([System.String]::Copy('%(LogicalName)').EndsWith('AnnotationOverlayWindow.uic'))" />
      <EmbeddedResource Remove="@(EmbeddedResource)"
                        Condition="$([System.String]::Copy('%(LogicalName)').EndsWith('SettingsWindow.uic'))" />
      <EmbeddedResource Remove="@(EmbeddedResource)"
                        Condition="$([System.String]::Copy('%(LogicalName)').EndsWith('PenSecondaryMenuWindow.uic'))" />
    </ItemGroup>
  </Target>

  <Import Project="$(JaliumSourceRoot)src\managed\Jalium.UI.Build\build\Jalium.UI.Build.targets"
          Condition="Exists('$(JaliumSourceRoot)src\managed\Jalium.UI.Build\build\Jalium.UI.Build.targets')" />

</Project>
