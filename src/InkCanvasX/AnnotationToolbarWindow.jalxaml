<Window xmlns="http://schemas.jalium.ui/2024"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:InkCanvasX"
        x:Class="InkCanvasX.AnnotationToolbarWindow"
        Title=""
        Width="320"
        Height="96"
        SizeToContent="Manual"
        WindowStartupLocation="Manual"
        Left="120"
        Top="120"
        Topmost="True"
        ShowInTaskbar="True"
        ResizeMode="NoResize"
        WindowStyle="None"
        IsShowTitleBar="False"
        IsShowMinimizeButton="False"
        IsShowMaximizeButton="False"
        IsShowCloseButton="False"
        HasSystemMenu="False"
        AllowsTransparency="True"
        SystemBackdrop="Acrylic"
        Background="Transparent"
        Foreground="#242424"
        Opacity="1">
    <Window.Resources>
        <!-- 工具按钮选中状态的毛玻璃高亮样式 -->
        <Style x:Key="ToolButtonStyle" TargetType="local:RadioToolToggleButton">
            <Setter Property="IsCompact" Value="True" />
            <Setter Property="LabelPosition" Value="Collapsed" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#242424" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background">
                        <Setter.Value>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#E0F0FF" Offset="0" />
                                <GradientStop Color="#D5E8FF" Offset="1" />
                            </LinearGradientBrush>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#0078D4" BlurRadius="8" ShadowDepth="0" Opacity="0.3" />
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="IsPointerOver" Value="True">
                    <Setter Property="Background" Value="#F0F0F0" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SettingsButtonStyle" TargetType="AppBarButton">
            <Setter Property="IsCompact" Value="True" />
            <Setter Property="LabelPosition" Value="Collapsed" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#242424" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsPointerOver" Value="True">
                    <Setter Property="Background" Value="#F0F0F0" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid HorizontalAlignment="Center"
          VerticalAlignment="Top"
          Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Height="64"
                Margin="6"
                CornerRadius="16"
                Background="#FAFAFA"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                Padding="10,8,10,8"
                ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect Color="#20000000"
                                  BlurRadius="16"
                                  ShadowDepth="2"
                                  Direction="270"
                                  Opacity="0.3" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Background="Transparent">
                    <local:RadioToolToggleButton x:Name="MouseToolToggle"
                                                 Style="{StaticResource ToolButtonStyle}"
                                                 Label="鼠标"
                                                 Margin="0,0,4,0" />
                    <local:RadioToolToggleButton x:Name="PenToolToggle"
                                                 Style="{StaticResource ToolButtonStyle}"
                                                 Label="笔"
                                                 Margin="4,0" />
                    <local:RadioToolToggleButton x:Name="EraseToolToggle"
                                                 Style="{StaticResource ToolButtonStyle}"
                                                 Label="橡皮"
                                                 Margin="4,0" />

                    <Border Width="1" Height="32" Margin="12,0"
                            Background="#D0D0D0" VerticalAlignment="Center" />

                    <AppBarButton x:Name="SettingsToolbarButton"
                                  Style="{StaticResource SettingsButtonStyle}"
                                  Label="设置"
                                  Margin="4,0,0,0"
                                  Click="SettingsToolbarButton_OnClick" />
            </StackPanel>
        </Border>

        <Border x:Name="DragHandleChrome"
                Grid.Column="2"
                Height="64"
                Width="44"
                Margin="6,6,6,6"
                CornerRadius="16"
                Background="#FAFAFA"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                Padding="0,8"
                ClipToBounds="True"
                Cursor="SizeAll"
                VerticalAlignment="Top">
            <Border.Effect>
                <DropShadowEffect Color="#20000000"
                                  BlurRadius="16"
                                  ShadowDepth="2"
                                  Direction="270"
                                  Opacity="0.3" />
            </Border.Effect>
        </Border>
    </Grid>
</Window>
