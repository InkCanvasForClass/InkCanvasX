<Window x:Class="SkiaAnnotate.Windows.AnnotationOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="#01000000"
        Topmost="True"
        ShowInTaskbar="False"
        Focusable="True">
    <Window.Resources>
        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="2,1" />
            <Setter Property="Padding" Value="11,5" />
            <Setter Property="MinWidth" Value="46" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#1F1F1F" />
            <Setter Property="Background" Value="#FAFAFA" />
            <Setter Property="BorderBrush" Value="#D5D5D5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#EEEEEE" />
                                <Setter Property="BorderBrush" Value="#BEBEBE" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#E3E3E3" />
                                <Setter Property="BorderBrush" Value="#A9A9A9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#3A7AFE" />
            <Setter Property="BorderBrush" Value="#2D67D7" />
        </Style>

        <Style x:Key="DangerToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#E65245" />
            <Setter Property="BorderBrush" Value="#C73D32" />
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid" Background="#01000000">
        <InkCanvas x:Name="OverlayInkCanvas" Background="#01000000" Cursor="Pen" />

        <Canvas x:Name="ToolbarHost" IsHitTestVisible="True">
            <Border x:Name="FloatingToolbar"
                    Width="640"
                    Background="#E9F6F7F9"
                    BorderBrush="#A7B0BA"
                    BorderThickness="1"
                    CornerRadius="10"
                    MouseLeftButtonDown="FloatingToolbar_OnMouseLeftButtonDown">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.32" Color="Black" />
                </Border.Effect>
                <DockPanel LastChildFill="True">
                    <Border DockPanel.Dock="Left"
                            Width="30"
                            Background="#4A5056"
                            CornerRadius="10,0,0,10"
                            Cursor="SizeAll"
                            MouseLeftButtonDown="DragHandle_OnMouseLeftButtonDown"
                            MouseMove="DragHandle_OnMouseMove"
                            MouseLeftButtonUp="DragHandle_OnMouseLeftButtonUp">
                        <TextBlock VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Foreground="White"
                                   Text="⋮⋮" />
                    </Border>

                    <StackPanel x:Name="ToolbarButtonPanel" Orientation="Horizontal" Margin="6,5">
                        <Button Style="{StaticResource ToolbarButtonStyle}" Content="上一页" Click="PreviousSlide_OnClick" />
                        <Button Style="{StaticResource ToolbarButtonStyle}" Content="下一页" Click="NextSlide_OnClick" />
                        <Border Width="1" Height="20" Margin="4,0" Background="#CFCFCF" VerticalAlignment="Center" />
                        <Button Style="{StaticResource PrimaryToolbarButtonStyle}" Content="画笔" Click="Pen_OnClick" />
                        <Button Style="{StaticResource ToolbarButtonStyle}" Content="橡皮" Click="Eraser_OnClick" />
                        <Button Style="{StaticResource ToolbarButtonStyle}" Content="清屏" Click="Clear_OnClick" />
                        <Border Width="1" Height="20" Margin="4,0" Background="#CFCFCF" VerticalAlignment="Center" />
                        <Button x:Name="ToggleButton" Style="{StaticResource ToolbarButtonStyle}" Content="收起" Click="ToggleToolbar_OnClick" />
                        <Button Style="{StaticResource DangerToolbarButtonStyle}" Content="退出" Click="Exit_OnClick" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </Canvas>
    </Grid>
</Window>
