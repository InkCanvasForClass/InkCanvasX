<Window x:Class="SkiaAnnotate.Windows.AnnotationOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SkiaAnnotate.Controls"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="#01000000"
        Topmost="True"
        ShowInTaskbar="False"
        Focusable="True">
    <Window.Resources>
        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="2,1" />
            <Setter Property="Padding" Value="11,5" />
            <Setter Property="MinWidth" Value="46" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#1F1F1F" />
            <Setter Property="Background" Value="#FAFAFA" />
            <Setter Property="BorderBrush" Value="#D5D5D5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#EAF0F6" />
                                <Setter Property="BorderBrush" Value="#94A8BF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#DCE7F3" />
                                <Setter Property="BorderBrush" Value="#7F97B2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="MinWidth" Value="34" />
            <Setter Property="Background" Value="#F7F9FB" />
            <Setter Property="BorderBrush" Value="#C6CDD6" />
        </Style>

        <Style x:Key="PrimaryToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource IconToolbarButtonStyle}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#3A7AFE" />
            <Setter Property="BorderBrush" Value="#2D67D7" />
        </Style>

        <Style x:Key="DangerToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource IconToolbarButtonStyle}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#E65245" />
            <Setter Property="BorderBrush" Value="#C73D32" />
        </Style>

        <Style x:Key="CollapsedArrowStyle" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#4A5056" />
            <Setter Property="BorderBrush" Value="#707880" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#5A626A" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#41484F" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid" Background="#01000000">
        <controls:DirectInkCanvasHost x:Name="OverlayInkCanvas"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch"
                                      Margin="0" />

        <Canvas x:Name="ToolbarHost" IsHitTestVisible="True">
            <Border x:Name="FloatingToolbar"
                    Width="640"
                    Background="#E9F6F7F9"
                    BorderBrush="#A7B0BA"
                    BorderThickness="1"
                    CornerRadius="10"
                    MouseLeftButtonDown="FloatingToolbar_OnMouseLeftButtonDown">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.32" Color="Black" />
                </Border.Effect>
                <DockPanel LastChildFill="True">
                    <Border DockPanel.Dock="Left"
                            Width="30"
                            Background="#4A5056"
                            CornerRadius="10,0,0,10"
                            Cursor="SizeAll"
                            MouseLeftButtonDown="DragHandle_OnMouseLeftButtonDown"
                            MouseMove="DragHandle_OnMouseMove"
                            MouseLeftButtonUp="DragHandle_OnMouseLeftButtonUp">
                        <TextBlock VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Foreground="White"
                                   Text="⋮⋮" />
                    </Border>

                    <StackPanel x:Name="ToolbarButtonPanel" Orientation="Horizontal" Margin="6,5">
                        <Button Style="{StaticResource IconToolbarButtonStyle}" Content="&#xE100;" Click="PreviousSlide_OnClick" ToolTip="上一页" />
                        <Button Style="{StaticResource IconToolbarButtonStyle}" Content="&#xE101;" Click="NextSlide_OnClick" ToolTip="下一页" />
                        <Border Width="1" Height="20" Margin="4,0" Background="#CFCFCF" VerticalAlignment="Center" />
                        <Button x:Name="PenButton" Style="{StaticResource IconToolbarButtonStyle}" Content="&#xED5F;" Click="Pen_OnClick" ToolTip="画笔" />
                        <Button x:Name="EraserButton" Style="{StaticResource IconToolbarButtonStyle}" Content="&#xE75C;" Click="Eraser_OnClick" ToolTip="橡皮" />
                        <Button Style="{StaticResource IconToolbarButtonStyle}" Content="&#xE74D;" Click="Clear_OnClick" ToolTip="清空当前页" />
                        <Border Width="1" Height="20" Margin="4,0" Background="#CFCFCF" VerticalAlignment="Center" />
                        <Button x:Name="ToggleButton" Style="{StaticResource IconToolbarButtonStyle}" Content="&#xE76C;" Click="ToggleToolbar_OnClick" ToolTip="收起或展开" />
                        <Button Style="{StaticResource DangerToolbarButtonStyle}" Content="&#xE8BB;" Click="Exit_OnClick" ToolTip="退出放映" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Button x:Name="CollapsedExpandButton"
                    Style="{StaticResource CollapsedArrowStyle}"
                    Content="&#xE76B;"
                    Visibility="Collapsed"
                    Click="CollapsedExpandButton_OnClick"
                    ToolTip="展开工具栏" />
        </Canvas>
    </Grid>
</Window>
