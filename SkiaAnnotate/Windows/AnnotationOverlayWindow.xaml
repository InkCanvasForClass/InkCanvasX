<Window x:Class="SkiaAnnotate.Windows.AnnotationOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SkiaAnnotate.Controls"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="#01000000"
        Topmost="True"
        ShowInTaskbar="False"
        Focusable="True">
    <Window.Resources>
        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinWidth" Value="40" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="#27272A" />
            <Setter Property="Background" Value="#E5E7EB" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F1F5F9" />
                                <Setter Property="BorderBrush" Value="#CBD5E1" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#E2E8F0" />
                                <Setter Property="BorderBrush" Value="#94A3B8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="MinWidth" Value="40" />
        </Style>

        <Style x:Key="PrimaryToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource IconToolbarButtonStyle}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#3A7AFE" />
            <Setter Property="BorderBrush" Value="#2D67D7" />
        </Style>

        <Style x:Key="DangerToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource IconToolbarButtonStyle}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Width" Value="48" />
            <Setter Property="Background" Value="#EF4444" />
            <Setter Property="BorderBrush" Value="#DC2626" />
        </Style>

        <Style x:Key="CollapsedArrowStyle" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#0F172A" />
            <Setter Property="BorderBrush" Value="#1E293B" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1E293B" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#020617" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid" Background="#01000000">
        <controls:CanvasInkCanvas x:Name="OverlayInkCanvas"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  Margin="0" />

        <Canvas x:Name="ToolbarHost" IsHitTestVisible="True">
            <Border x:Name="FloatingToolbar"
                    Width="560"
                    Height="50"
                    Background="#E5E7EB"
                    BorderBrush="#C7CBD1"
                    BorderThickness="1"
                    CornerRadius="8"
                    MouseLeftButtonDown="FloatingToolbar_OnMouseLeftButtonDown">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="0" Opacity="0.15" Color="Black" />
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border DockPanel.Dock="Left"
                            Grid.Column="0"
                            Width="48"
                            Height="50"
                            Background="#E5E7EB"
                            BorderBrush="#C7CBD1"
                            BorderThickness="0,0,1,0"
                            CornerRadius="8,0,0,8"
                            Cursor="SizeAll"
                            MouseLeftButtonDown="DragHandle_OnMouseLeftButtonDown"
                            MouseMove="DragHandle_OnMouseMove"
                            MouseLeftButtonUp="DragHandle_OnMouseLeftButtonUp">
                        <TextBlock VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Foreground="#334155"
                                   FontSize="16"
                                   Text="☰" />
                    </Border>

                    <StackPanel x:Name="ToolbarButtonPanel"
                                Grid.Column="1"
                                Orientation="Horizontal"
                                Margin="6,5">
                        <Button Style="{StaticResource IconToolbarButtonStyle}" Content="&#xE100;" Click="PreviousSlide_OnClick" ToolTip="上一页" />
                        <Button Style="{StaticResource IconToolbarButtonStyle}" Content="&#xE101;" Click="NextSlide_OnClick" ToolTip="下一页" />
                        <Border Width="1" Height="24" Margin="4,0" Background="#CED3DA" VerticalAlignment="Center" />
                        <Button x:Name="PenButton" Style="{StaticResource IconToolbarButtonStyle}" Content="&#xED5F;" Click="Pen_OnClick" ToolTip="画笔" />
                        <Button x:Name="EraserButton" Style="{StaticResource IconToolbarButtonStyle}" Content="&#xE75C;" Click="Eraser_OnClick" ToolTip="橡皮" />
                        <Button x:Name="MouseModeButton" Style="{StaticResource IconToolbarButtonStyle}" Content="&#xE962;" Click="MouseMode_OnClick" ToolTip="鼠标模式（点击穿透）" />
                        <Button Style="{StaticResource IconToolbarButtonStyle}" Content="&#xE74D;" Click="Clear_OnClick" ToolTip="清空当前页" />
                        <Border Width="1" Height="24" Margin="4,0" Background="#CED3DA" VerticalAlignment="Center" />
                        <Button x:Name="ToggleButton" Style="{StaticResource IconToolbarButtonStyle}" Content="&#xE76C;" Click="ToggleToolbar_OnClick" ToolTip="收起或展开" />
                        <Button Style="{StaticResource DangerToolbarButtonStyle}" Content="&#xE8BB;" Click="Exit_OnClick" ToolTip="退出放映" />
                    </StackPanel>
                </Grid>
            </Border>

            <Button x:Name="CollapsedExpandButton"
                    Style="{StaticResource CollapsedArrowStyle}"
                    Content="&#xE76B;"
                    Visibility="Collapsed"
                    Click="CollapsedExpandButton_OnClick"
                    ToolTip="展开工具栏" />
        </Canvas>
    </Grid>
</Window>
